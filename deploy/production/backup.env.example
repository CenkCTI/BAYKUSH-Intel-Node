# Optional root-only host environment for the off-host backup transport.
# Copy to /etc/baykush/backup.env, owner root:root, mode 0600 or 0400.
# Never commit the populated file and never pass these values into Node containers.

# S3-compatible example. Prefer short-lived/instance credentials where supported.
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=auto
