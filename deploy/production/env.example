# NODE-8 production runtime template.
# Copy to /etc/baykush/runtime.env on the host, set owner root:root and mode 0600.
# This file contains paths and non-secret operational configuration only.

# Immutable application image. Prefer the exact digest emitted by CI.
BAYKUSH_NODE_IMAGE=ghcr.io/cenkcti/baykush-intel-node@sha256:REPLACE_ME

# Public HTTPS identity.
NODE_HOSTNAME=node.example.invalid
ACME_EMAIL=

# Host-private secret directory. Create a dedicated host group with this numeric GID;
# do not add interactive users to it. Directory: root:<gid> 0750, files: root:<gid> 0440.
# Containers receive only this supplemental GID and the directory is mounted read-only.
BAYKUSH_SECRET_DIR=/etc/baykush/secrets
BAYKUSH_SECRET_GID=2000

# PostgreSQL bootstrap/migration identity. Its password is used only by the
# postgres container and the migration-only db_migrator_url secret. Runtime
# services never receive this credential after NODE-8C.
POSTGRES_DB=baykush
POSTGRES_USER=baykush

# Required database secret files under BAYKUSH_SECRET_DIR:
#   postgres_password   bootstrap server password
#   db_migrator_url     owner/migration-only connection URL
# Runtime role password/URL files are generated/rotated by provision-db-roles.sh:
#   db_api_{password,url}, db_ingest_{password,url}, db_projection_{password,url},
#   db_stream_{password,url}, db_recovery_{password,url}

# Optional provider credential files. Leave blank when that provider credential is not configured.
# Values are container paths, not host paths.
NVD_API_KEY_FILE=
THREATFOX_AUTH_KEY_FILE=
MALWAREBAZAAR_AUTH_KEY_FILE=
IPINFO_LITE_TOKEN_FILE=

# Server-to-server API rate limits. Credential registry is mounted from
# /etc/baykush/secrets/api_credentials.json and never appears in this file.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_STANDARD=120
API_RATE_LIMIT_EXPENSIVE=30

# Host-only smoke credential file.
BAYKUSH_SMOKE_TOKEN_FILE=/etc/baykush/secrets/smoke_api_token

# Operational limits.
SOURCE_HTTP_TIMEOUT_MS=30000
GLOBAL_MAX_RAW_RECORD_BYTES=8388608
HEARTBEAT_INTERVAL_MS=10000
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
STREAM_RAW_RETENTION_HOURS=48
STREAM_QUEUE_MAX_MESSAGES=50000
STREAM_QUEUE_MAX_BYTES=67108864
STREAM_SEGMENT_MAX_MESSAGES=5000
STREAM_SEGMENT_MAX_BYTES=4194304
RECOVERY_AUTO_ENABLED=false
RECOVERY_MAX_ATTEMPTS=4
RECOVERY_ARCHIVE_SETTLE_SECONDS=900
RECOVERY_MAX_ARTIFACT_BYTES=536870912
RECOVERY_MIN_FREE_DISK_BYTES=1073741824
RECOVERY_ARTIFACT_RETENTION_HOURS=24
RECOVERY_DECODER_TIMEOUT_MS=300000
RECOVERY_DECODER_MAX_OUTPUT_BYTES=1073741824
RECOVERY_DECODER_MAX_RECORDS=10000000
RECOVERY_PAUSE_ON_STREAM_UNHEALTHY=true
