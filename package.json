    "test:migration": "node scripts/test-migration.mjs",
    "test:runtime": "tsx scripts/test-runtime.ts",
    "test:node2a": "tsx scripts/test-node2a.ts",
    "test:node2b": "tsx scripts/test-node2b.ts",
    "test:node2c": "tsx scripts/test-node2c.ts",
    "test:node2d": "tsx scripts/test-node2d.ts",
    "test:node2e": "tsx scripts/test-node2e.ts",
    "test:node2f": "tsx scripts/test-node2f.ts",
    "test:node2g": "tsx scripts/test-node2g.ts",
    "test:node2g-resilience": "tsx scripts/test-node2g-resilience.ts",
    "test:node3": "tsx scripts/test-node3-measurement-backbone.ts",
    "test:node4-backfill": "tsx scripts/test-node4-backfill-isolation.ts",
    "test:node5a": "tsx scripts/test-node5a.ts",
