    "start:scheduler": "node dist/scheduler/main.js",
    "start:worker": "node dist/worker/node5-main.js",
    "start:normalizer": "node dist/normalizer/main.js",
    "start:measurement": "node dist/measurement/main.js",
    "start:backfill": "node dist/backfill/main.js",
    "start:stream": "node dist/stream/main.js",
    "start:recovery": "node dist/recovery/main.js",
    "start:discovery": "node dist/discovery/worker/main.js"
