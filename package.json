    "dev:backfill": "tsx src/backfill/main.ts",
    "dev:stream": "tsx src/stream/main.ts",
    "dev:recovery": "tsx src/recovery/main.ts",
    "dev:discovery": "tsx src/discovery/worker/main.ts",
