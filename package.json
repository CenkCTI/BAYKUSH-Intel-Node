    "node6:final-audit": "tsx src/cli/node6.ts final-audit",
    "node6-2:final-audit": "tsx scripts/node6-2-final-audit.ts",
    "node6-2:security-audit": "tsx scripts/node6-2-security-audit.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "dev:api": "tsx src/api/main.ts",
    "dev:scheduler": "tsx src/scheduler/main.ts",
    "dev:worker": "tsx src/worker/node5-main.ts",
    "dev:normalizer": "tsx src/normalizer/main.ts",
