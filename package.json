{
  "name": "@baykush/intelligence-node",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shared intelligence data runtime for the BAYKUSH ecosystem.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:migration": "node scripts/test-migration.mjs",
    "test:runtime": "tsx scripts/test-runtime.ts",
    "test:node2a": "tsx scripts/test-node2a.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "dev:api": "tsx src/api/main.ts",
    "dev:scheduler": "tsx src/scheduler/main.ts",
    "dev:worker": "tsx src/worker/main.ts",
    "dev:normalizer": "tsx src/normalizer/main.ts",
    "sources": "tsx src/cli/sources.ts",
    "start:api": "node dist/api/main.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:normalizer": "node dist/normalizer/main.js"
  },
  "dependencies": {
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
